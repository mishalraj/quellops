AIDBG_LOG_SERVICE_TOKEN=generate-a-random-service-token
AIDBG_LOG_API_TOKEN=generate-a-random-api-token
AIDBG_ADMIN_API_TOKEN=generate-a-random-admin-token
AIDBG_CHANGE_INGEST_TOKEN=generate-a-random-change-ingest-token
AIDBG_GITHUB_WEBHOOK_SECRET=generate-a-random-github-webhook-secret
AIDBG_K8S_AGENT_TOKEN=generate-a-random-kubernetes-agent-token
AIDBG_K8S_RETENTION_EVENTS=5000
AIDBG_INCIDENT_RETENTION=500
AIDBG_MASTER_KEY=generate-with-openssl-rand-base64-32
# Optional TLS between the Python backend and Go logs service.
AIDBG_LOG_TLS_CERT=
AIDBG_LOG_TLS_KEY=
AIDBG_LOG_TLS_CA=
AIDBG_LOG_TLS_SERVER_NAME=
AIDBG_POSTGRES_PASSWORD=generate-a-random-postgres-password
# Leave blank for SQLite. For PostgreSQL use:
# postgresql://aidbg:PASSWORD@aidbg-postgres:5432/aidbg
AIDBG_CONTROL_DATABASE_URL=
# Use database for zero-setup mode or kafka for the durable Kafka outbox publisher.
AIDBG_EVENT_TRANSPORT=database
AIDBG_KAFKA_BOOTSTRAP_SERVERS=
AIDBG_KAFKA_K8S_TOPIC=quellops.kubernetes.events.v1
AIDBG_KAFKA_CONSUMER_GROUP=quellops-central-v1
# The Docker stack runs a separate worker. Set true only for a single-process setup.
AIDBG_KAFKA_CONSUMER_EMBEDDED=false
# Optional for secured Kafka clusters (for example SASL_SSL + SCRAM-SHA-512).
AIDBG_KAFKA_SECURITY_PROTOCOL=
AIDBG_KAFKA_SASL_MECHANISM=
AIDBG_KAFKA_SASL_USERNAME=
AIDBG_KAFKA_SASL_PASSWORD=
AIDBG_KAFKA_SSL_CA_LOCATION=
